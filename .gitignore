# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/

# Local environment and editor state
.env
.env.*
.idea/
.vscode/
.cursor/

# Local working files
.ralph/
docs/demo-talk-track.md

# Databricks CLI bundle state (includes the ids scripts/setup.py records) and
# per-user bundle overrides
.databricks/
databricks.local.yml
config/ai_roi_assets.json

# Regenerated by data_generation/ on every setup run. landing/ stays committed
# because the seed-invariant tests read it.
data_generation/output/close_folder/
data_generation/output/documents/

# tsc incremental cache. Regenerated by every build and stored as a single line,
# so tracking it guarantees a merge conflict on any branch that builds.
app/frontend/tsconfig.tsbuildinfo

# Built by the Databricks Apps runtime on deploy (npm run build); not committed here.
app/frontend/dist/
