              {
                "name": "q_month",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "Month",
                      "expression": "`Month`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "Month",
                    "displayName": "Month",
                    "queryName": "q_month"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
