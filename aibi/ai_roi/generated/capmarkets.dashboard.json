{
  "datasets": [
    {
      "name": "ds_ai_roi",
      "displayName": "AI ROI (capmarkets)",
      "asset_name": "office_of_cfo.capmarkets_serving.mv_ai_roi"
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "# AI ROI \u2014 Capital Markets\n",
                "\n",
                "Governed by `office_of_cfo.capmarkets_serving.mv_ai_roi`. ",
                "**Profitability Index is a gross ratio, not a percentage: realised value divided by fully loaded cost; 1.0 is break-even.** ",
                "All value includes metered, attested and modelled value. Proven value includes only metered and attested value. ",
                "`Revenue per Mtok \u00f7 Fully Loaded Cost per Mtok = Profitability Index`."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-fully-loaded-cost",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "measure(fully_loaded_cost)",
                      "expression": "MEASURE(`Fully Loaded Cost`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(fully_loaded_cost)",
                  "displayName": "Fully Loaded Cost",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Fully Loaded Cost",
                "showDescription": true,
                "description": "Run cost + amortised investment + allocated build"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-realised-value-all",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "measure(realised_value_all)",
                      "expression": "MEASURE(`Realised Value All`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(realised_value_all)",
                  "displayName": "Realised Value (All)",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Realised Value (All)",
                "showDescription": true,
                "description": "Metered + attested + modelled"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-profitability-index",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "measure(profitability_index)",
                      "expression": "MEASURE(`Profitability Index`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(profitability_index)",
                  "displayName": "Profitability Index",
                  "format": {
                    "type": "number-plain",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Profitability Index",
                "showDescription": true,
                "description": "Gross ratio; 1.0 = break-even"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-revenue-per-mtok",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "measure(revenue_per_mtok)",
                      "expression": "MEASURE(`Realised Value All`) / NULLIF(MEASURE(`Total Tokens`) / 1000000, 0)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(revenue_per_mtok)",
                  "displayName": "Revenue per Mtok",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue per Mtok",
                "showDescription": true,
                "description": "\u00f7 Fully Loaded Cost per Mtok = Profitability Index"
              }
            }
          },
          "position": {
            "x": 9,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "filter-business-unit",
            "queries": [
              {
                "name": "q_business_unit",
