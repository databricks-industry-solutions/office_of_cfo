            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "profitability-ranking",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "Business Unit",
                      "expression": "`Business Unit`"
                    },
                    {
                      "name": "measure(profitability_index)",
                      "expression": "MEASURE(`Profitability Index`)"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "ASC",
                      "expression": "MEASURE(`Profitability Index`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "measure(profitability_index)",
                  "displayName": "Profitability Index",
                  "scale": {
                    "type": "quantitative"
                  },
                  "format": {
                    "type": "number",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 2
                    }
                  },
                  "axis": {
                    "title": "Profitability Index (1.0 = break-even)"
                  }
                },
                "y": {
                  "fieldName": "Business Unit",
                  "displayName": "Business Unit",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "query-order"
                    }
                  },
                  "axis": {
                    "title": "Business Unit"
                  }
                },
                "color": {
                  "value": {
                    "themeColorType": "visualizationColors",
                    "position": 1
                  }
                }
              },
              "annotations": [
                {
                  "type": "vertical-line",
                  "encodings": {
                    "x": {
                      "dataValue": "1",
                      "dataType": "DECIMAL"
                    },
                    "label": {
                      "value": "1.0 break-even"
                    },
                    "color": {
                      "value": {
                        "themeColorType": "visualizationColors",
                        "position": 0
                      }
                    }
                  }
                }
              ],
              "frame": {
                "showTitle": true,
                "title": "Profitability ranking (worst first)",
                "showDescription": true,
                "description": "Ranked ascending. The explicit 1.0 marker separates value destruction from value creation."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 8,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "all-vs-proven",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "Business Unit",
                      "expression": "`Business Unit`"
                    },
                    {
                      "name": "measure(profitability_index)",
                      "expression": "MEASURE(`Profitability Index`)"
                    },
                    {
                      "name": "measure(profitability_index_proven)",
                      "expression": "MEASURE(`Realised Value Proven`) / NULLIF(MEASURE(`Fully Loaded Cost`), 0)"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "ASC",
                      "expression": "MEASURE(`Profitability Index`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "mark": {
                "layout": "group"
              },
              "encodings": {
                "x": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "format": {
                    "type": "number",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 2
                    }
                  },
                  "axis": {
                    "title": "Index (1.0 = break-even)"
                  },
                  "fields": [
                    {
                      "fieldName": "measure(profitability_index)",
                      "displayName": "All value (incl. modelled)"
                    },
                    {
                      "fieldName": "measure(profitability_index_proven)",
                      "displayName": "Proven only"
                    }
                  ]
                },
                "y": {
                  "fieldName": "Business Unit",
                  "displayName": "Business Unit",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "query-order"
                    }
                  },
                  "axis": {
                    "title": "Business Unit"
                  }
                }
              },
              "annotations": [
                {
                  "type": "vertical-line",
                  "encodings": {
                    "x": {
                      "dataValue": "1",
                      "dataType": "DECIMAL"
                    },
                    "label": {
                      "value": "1.0 break-even"
                    },
                    "color": {
                      "value": {
                        "themeColorType": "visualizationColors",
                        "position": 0
                      }
                    }
                  }
                }
              ],
              "frame": {
                "showTitle": true,
                "title": "All-value vs proven-only index",
                "showDescription": true,
                "description": "The gap is modelled value; the two indices are never substitutes."
              }
            }
          },
          "position": {
            "x": 6,
            "y": 8,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "unit-economics-trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_ai_roi",
                  "fields": [
                    {
                      "name": "monthly(Month)",
                      "expression": "DATE_TRUNC(\"MONTH\", `Month`)"
                    },
                    {
                      "name": "measure(revenue_per_mtok)",
                      "expression": "MEASURE(`Realised Value All`) / NULLIF(MEASURE(`Total Tokens`) / 1000000, 0)"
                    },
                    {
                      "name": "measure(fully_loaded_cost_per_mtok)",
                      "expression": "MEASURE(`Fully Loaded Cost`) / NULLIF(MEASURE(`Total Tokens`) / 1000000, 0)"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "ASC",
                      "expression": "DATE_TRUNC(\"MONTH\", `Month`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "monthly(Month)",
                  "displayName": "Month",
                  "scale": {
                    "type": "temporal"
                  },
                  "axis": {
                    "title": "Month"
                  }
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "decimalPlaces": {
                      "type": "exact",
                      "places": 2
                    }
                  },
                  "axis": {
                    "title": "USD per million tokens"
                  },
                  "fields": [
                    {
                      "fieldName": "measure(revenue_per_mtok)",
                      "displayName": "Revenue per Mtok"
                    },
                    {
                      "fieldName": "measure(fully_loaded_cost_per_mtok)",
                      "displayName": "Fully Loaded Cost per Mtok"
                    }
                  ]
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Unit economics trend",
                "showDescription": true,
                "description": "Revenue and fully loaded cost per million tokens share one axis; their ratio is the profitability index."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 14,
            "width": 12,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "business-unit-detail",
