                      "abbreviation": "compact",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "measure(profitability_index)",
                    "displayName": "Profitability Index",
                    "format": {
                      "type": "number",
                      "decimalPlaces": {
                        "type": "exact",
                        "places": 2
                      }
                    }
                  },
                  {
                    "fieldName": "measure(profitability_index_proven)",
