                      "name": "Business Unit",
                      "expression": "`Business Unit`"
                    },
                    {
                      "name": "measure(fully_loaded_cost)",
                      "expression": "MEASURE(`Fully Loaded Cost`)"
                    },
                    {
                      "name": "measure(run_cost)",
                      "expression": "MEASURE(`Token Run Cost`)"
                    },
                    {
                      "name": "measure(realised_value_proven)",
                      "expression": "MEASURE(`Realised Value Proven`)"
                    },
                    {
                      "name": "measure(realised_value_all)",
                      "expression": "MEASURE(`Realised Value All`)"
                    },
                    {
                      "name": "measure(profitability_index)",
                      "expression": "MEASURE(`Profitability Index`)"
                    },
                    {
                      "name": "measure(profitability_index_proven)",
                      "expression": "MEASURE(`Realised Value Proven`) / NULLIF(MEASURE(`Fully Loaded Cost`), 0)"
                    },
                    {
                      "name": "measure(revenue_per_mtok)",
                      "expression": "MEASURE(`Realised Value All`) / NULLIF(MEASURE(`Total Tokens`) / 1000000, 0)"
                    },
                    {
                      "name": "measure(fully_loaded_cost_per_mtok)",
                      "expression": "MEASURE(`Fully Loaded Cost`) / NULLIF(MEASURE(`Total Tokens`) / 1000000, 0)"
                    },
                    {
                      "name": "measure(run_cost_per_mtok)",
                      "expression": "MEASURE(`Token Run Cost`) / NULLIF(MEASURE(`Total Tokens`) / 1000000, 0)"
                    },
                    {
                      "name": "measure(tokens)",
                      "expression": "MEASURE(`Total Tokens`)"
                    },
                    {
                      "name": "measure(requests)",
                      "expression": "MEASURE(`Requests`)"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "ASC",
                      "expression": "MEASURE(`Profitability Index`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "Business Unit",
                    "displayName": "Business Unit"
                  },
