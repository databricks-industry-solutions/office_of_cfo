flowchart TB

%% ================= LAYER 1: SOURCES =================
subgraph SOURCES["① SOURCES"]
    direction LR
    SP["SharePoint — Month-End Close folder<br/>CSV / XLSX adjustments"]
    GL["Subledgers + GL<br/>SAP · Workday · AFAS · Bank feed"]
    DOCS["Source documents<br/>Competitor filings & contracts (PDF)"]
end

%% ================= LAYER 2: DATABRICKS PLATFORM =================
subgraph PLATFORM["② DATABRICKS PLATFORM — governed by Unity Catalog"]
    direction TB
    UC["🛡️ Unity Catalog — governance · lineage · ACLs · DQ"]
    LF["Lakeflow pipeline<br/>Ingest → Governed Close → Data Quality<br/>(bronze / silver)"]
    FM["Foundation Model API<br/>ai_parse_document · ai_extract · ai_query<br/>offline IDP for Close Support"]
    SV["Serving views<br/>real-time Trial Balance"]
    LB["Lakebase (Postgres)<br/>OLTP system of record<br/>adjustments + close tasks"]
    GEN["Genie Space<br/>natural-language query"]
end

%% ================= LAYER 3: APPLICATION =================
subgraph APP["③ APPLICATION — Databricks App"]
    direction LR
    API["FastAPI backend (Python)"]
    SPA["React SPA frontend<br/>served as static files by FastAPI"]
end

%% ================= LAYER 4: USERS =================
subgraph USERS["④ USERS"]
    direction LR
    CFO["CFO"]
    CTRL["Controller"]
    ACCT["Accountant"]
end

%% ---- Sources into the platform ----
SP --> LF
GL --> LF
DOCS --> FM

%% ---- Platform internal flow ----
FM -->|feeds governed<br/>Close Support tables| LF
LF --> SV
LB -.->|adjustments flow<br/>back to the lake| LF

%% ---- Unity Catalog governs the platform ----
UC -. governs .-> LF
UC -. governs .-> FM
UC -. governs .-> SV
UC -. governs .-> LB
UC -. governs .-> GEN

%% ---- Platform delivers data down to the app ----
SV -->|DBSQL — read governed UC tables| API
LB <-->|Postgres pool — read / write| API
GEN -->|Genie API — NL query| API

%% ---- App serves the UI ----
API --> SPA

%% ---- App presents to users ----
SPA --> CFO
SPA --> CTRL
SPA --> ACCT

