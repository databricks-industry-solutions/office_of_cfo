classDef source   fill:#EEF2F6,stroke:#5A6B7B,stroke-width:1px,color:#1B3139;
classDef data     fill:#FFF3EC,stroke:#FF3621,stroke-width:1.5px,color:#1B3139;
classDef gov      fill:#FF3621,stroke:#C42B18,stroke-width:2px,color:#FFFFFF;
classDef app      fill:#FFE3D6,stroke:#FF5F46,stroke-width:1.5px,color:#1B3139;
classDef user     fill:#1B3139,stroke:#0E1A20,stroke-width:1px,color:#FFFFFF;

class SP,GL,DOCS source;
